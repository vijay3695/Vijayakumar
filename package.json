{
  "name": "vijayakumar-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "React and TypeScript portfolio with an optional interactive book using the original OpenZine/Paper Mono page-turn renderer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "extract": "python3 scripts/extract_resume.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "puppeteer": "^25.13.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
